# Application
APP_PORT=3000
PORT=3000
NODE_ENV=production

# AI provider key
# Put your real key in .env, never commit it to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Tunnel
# Copy this from Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Install and run connector.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
