PORT=3000
CORS_ORIGIN=*

# Firebase project của app PocketStory
FIREBASE_PROJECT_ID=pocketstory-6d696

# Chọn một trong hai cách cấu hình Firebase Admin:
# Cách 1: Dùng biến môi trường chứa service account JSON trên một dòng.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cách 2: Dùng đường dẫn tới file service account JSON trên server.
# GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# OpenAI API key chỉ đặt trong backend, không đặt trong Flutter app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
